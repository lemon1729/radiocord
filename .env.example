# ========================================================
# 디스코드 음악 및 TTS 봇 환경 설정 (Environment Variables)
# ========================================================

# 디스코드 개발자 포털(https://discord.com/developers/applications)에서 발급받은 봇 토큰
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# (선택) 테스트할 서버(길드) ID
# 여기에 서버 ID를 적으면 봇 실행 시 슬래시 커맨드가 전역(최대 1시간 소요) 대신 해당 서버에 '즉시' 등록됩니다.
# 비워두면 전역으로 등록됩니다.
DISCORD_GUILD_ID=

# 메시지 내용 수신 권한 (채팅 TTS 및 덕킹 필수)
# 디스코드 개발자 포털의 Bot 탭에서 "MESSAGE CONTENT INTENT"를 반드시 활성화해야 합니다.
ENABLE_MESSAGE_CONTENT=true
